# Servio Frontend Environment Configuration
# Copy this file to `.env.local` and adjust for your restaurant LAN.

# Set to `true` to run with built-in offline Filipino restaurant mock data.
# Set to `false` to connect to the live Laravel Sanctum backend API.
VITE_USE_MOCK=true

# Base URL of the local Laravel API server on your restaurant LAN
# Example for LAN server: http://192.168.1.100:8000/api
VITE_API_BASE_URL=http://localhost:8000/api
